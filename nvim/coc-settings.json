{
	"go.checkForUpdates": "disabled",
	"go": {
		"disable": {
			"workspaceFolders": false
		},
		"goplsPath": "gopls",
		"goplsOptions": {
			"verboseOutput": true,
			"semanticTokens": true
		},
		"trace": {
			"server": true
		}
	},
	"list": {
		"previewSplitRight": true
	},
	"python": {
		"pythonPath": "python3"
	},
	"python.formatting.provider": "black",
	"python.formatting.blackArgs": [
		"--line-length=100"
	],
	"semanticTokens": {
		"filetypes": [
			"c",
			"cpp"
		]
	},
	"clangd.arguments": [
		"--background-index",
		"--clang-tidy",
		"--completion-style=detailed",
		"--header-insertion=iwyu",
		"--query-driver=/usr/bin/*gcc*,/usr/bin/*g++*,/usr/bin/*clang*,/opt/homebrew/**/gcc*,/opt/homebrew/**/g++*,/opt/homebrew/**/clang*,/usr/local/**/gcc*,/usr/local/**/g++*,/usr/local/**/clang*,/home/linuxbrew/**/gcc*,/home/linuxbrew/**/g++*,/home/linuxbrew/**/clang*",
		"--enable-config",
		"-j=8"
	],
	"suggest.noselect": true,
	"diagnostic.enableMessage": "always",
	"diagnostic.level": "information",
	"diagnostic.messageTarget": "float",
	"coc.preferences.enableMessageDialog": true,
	"workspace.ignoredFolders": [
		"$HOME"
	]
}
