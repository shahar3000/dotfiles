" ============================================================================
" vimwiki + markdown  (see CHEATSHEET.md 'Markdown/vimwiki' for the why)
" ============================================================================
" Wiki path is machine-specific — set via ~/.vimrc.local (sourced at top).
" install.sh prompts for it. Default below is used if not overridden.
if !exists('g:vimwiki_path') | let g:vimwiki_path = '~/vimwiki/src' | endif
let g:vimwiki_list = [{
	\ 'path': g:vimwiki_path,
	\ 'syntax': 'markdown',
	\ 'ext': '.md'}]

" VERIFIED: vimwiki assigns filetype 'vimwiki' to .md files (tested). To let
" markdown-preview fire on wiki files, register the markdown filetype too so
" the combined filetype becomes 'vimwiki.markdown':
let g:vimwiki_filetypes = ['markdown']

" Folding is owned by vimwiki (NOT vim-markdown-folding, which would conflict).
" 'expr' folds sections + code blocks; 'list' also folds list subitems but is
" much slower on large files.
let g:vimwiki_folding = 'expr'

" bullets.vim: scope AWAY from vimwiki (which already does lists/checkboxes
" natively) to avoid double-handling. Only active in plain markdown/text/commits.
let g:bullets_enabled_file_types = ['markdown', 'text', 'gitcommit']

let g:markdown_fenced_languages = ['bash', 'c', 'cpp', 'python', 'go', 'vim', 'json']
