" ============================================================================
" vimrc — shared by vim (~/.vimrc) and nvim (~/.config/nvim/init.vim sources this)
" vim-plug + coc.nvim stack. Some additions adapted from github.com/liralon/environment.
" ============================================================================

set nocompatible

" Machine-specific settings live in ~/.vimrc.local (untracked, gitignored).
" Sourced early so vars like g:vimwiki_path are set before they're used below.
" e.g.  let g:vimwiki_path = '/home/me/notes/src'
if filereadable(expand('~/.vimrc.local'))
	source ~/.vimrc.local
endif

if !has('nvim')
	" Only force a term when none is set — otherwise respect $TERM so tmux/screen
	" sessions (screen-256color / tmux-256color) keep correct key handling.
	if empty($TERM) | set term=xterm-256color | endif
endif
" Enable 24-bit color ONLY when the terminal genuinely supports it. Blindly
" setting termguicolors on a 256-color terminal (e.g. macOS Terminal.app, or an
" SSH hop that dropped $COLORTERM) crushes gruvbox's hex into muddy 256-color
" approximations. Without termguicolors, gruvbox uses its proper 256-color
" palette, which is designed to look good. $COLORTERM=truecolor/24bit is the
" signal; tmux/screen with RGB caps also qualifies.
if has('termguicolors')
	if $COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit'
		set termguicolors
	endif
endif

" ---- Clipboard: use the system clipboard (+ register) when available ----
" unnamedplus = the '+' register (Ctrl-C/Ctrl-V clipboard on Linux/WSL).
" Plain 'unnamed' is the '*' PRIMARY register — distinct on X11/Wayland.
if has('unnamedplus')
	set clipboard+=unnamedplus
elseif has('clipboard')
	set clipboard+=unnamed
endif

" ============================================================================
" Plugins
" ============================================================================
call plug#begin('~/.vim/plugged')

" Git
Plug 'tpope/vim-fugitive'           " :Git, :Gvdiffsplit, :Git blame
Plug 'jreybert/vimagit'             " magit-style staging/commit UI

" Fuzzy find
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'

" Navigation / UI
Plug 'scrooloose/nerdtree'          " file tree
Plug 'vim-airline/vim-airline'      " statusline (coc + git aware, auto-themed)
Plug 'vim-airline/vim-airline-themes'
Plug 'gruvbox-community/gruvbox'    " colorscheme (maintained fork of morhetz/gruvbox)
Plug 'justinmk/vim-syntax-extra'    " better C syntax
Plug 'ludovicchabant/vim-gutentags' " auto-manage ctags in background
Plug 'inkarkat/vim-ingo-library'    " prerequisite of vim-mark
Plug 'inkarkat/vim-mark'            " multi-color word highlighting (see maps below)
Plug 'troydm/zoomwintab.vim'        " fullscreen-toggle a split (like tmux prefix z)
Plug 'wsdjeg/vim-fetch'             " open file.c:42 -> jump to line 42
Plug 'christoomey/vim-tmux-navigator' " move across vim splits + tmux panes

" Editing
Plug 'tpope/vim-commentary'         " gc to comment/uncomment
Plug 'tpope/vim-sleuth'             " auto-detect indentation per file

" LSP / completion (coc). coc auto-installs these language servers on first launch:
Plug 'neoclide/coc.nvim', {'branch': 'release'}
let g:coc_global_extensions = ['coc-clangd', 'coc-pyright', 'coc-go']  " C++/Python/Go IDE

" Debugging
Plug 'puremourning/vimspector'      " step-debugger for C++/Python/Go
Plug 'rhysd/vim-clang-format'       " clang-format integration

" Notes (vimwiki) + markdown
Plug 'vimwiki/vimwiki'
Plug 'iamcco/markdown-preview.nvim', { 'do': 'cd app && npx --yes yarn install' } " live md preview
Plug 'bullets-vim/bullets.vim'      " list/checkbox automation (scoped below, NOT in vimwiki)

" vim-mark: suppress its default maps BEFORE the plugin loads (at plug#end),
" so we can bind our own without <Leader>r shadowing <Leader>rn (coc-rename).
let g:mw_no_mappings = 1

call plug#end()

" ============================================================================
" gutentags — keep tag files OUT of project repos
" ============================================================================
" Store all generated tags in a central cache dir instead of writing a 'tags'
" file into every repo root (which would clutter git status / risk being
" committed). Nothing to .gitignore per-project this way.
let g:gutentags_cache_dir = expand('~/.cache/gutentags')
if !isdirectory(expand('~/.cache/gutentags'))
	call mkdir(expand('~/.cache/gutentags'), 'p', 0700)
endif

" ============================================================================
" Colorscheme & appearance
" ============================================================================
set background=dark
let g:gruvbox_contrast_dark = 'medium'
try
	colorscheme gruvbox
catch /^Vim\%((\a\+)\)\=:E185/
	colorscheme elflord
endtry

" airline: use gruvbox theme, show coc status + git branch, powerline symbols.
let g:airline_theme = 'gruvbox'
let g:airline#extensions#coc#enabled = 1
let g:airline#extensions#branch#enabled = 1
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#formatter = 'unique_tail'
" Powerline separators (the triangle edges). Requires a Nerd Font in your
" terminal (JetBrainsMono Nerd Font Mono) — consistent with the starship prompt
" and tmux powerline bar, which also need it. Set to 0 in ~/.vimrc.local on a
" box without the font to avoid tofu.
let g:airline_powerline_fonts = 1

syntax on
set switchbuf=useopen
set nu
set numberwidth=5
set hlsearch
set incsearch
set backspace=indent,eol,start
set ruler
let mapleader = ","
set laststatus=2
" history/marks persistence: nvim calls it 'shada', vim calls it 'viminfo'
if has('nvim')
	set shada='100,<50,s10,h
else
	set viminfo='100,<50,s10,h
endif
set relativenumber
set hidden
set splitright
set splitbelow
set mmp=5000
set mouse=
set nobackup
set nowritebackup
set noswapfile
set signcolumn=yes
set updatetime=300                  " snappier coc diagnostics (default 4000ms)
set ignorecase
set smartcase                       " case-sensitive only if pattern has uppercase
set scrolloff=5                     " keep 5 lines of context around cursor

" persistent undo across sessions
set undofile
set undodir=~/.vim/undo
if !isdirectory(expand('~/.vim/undo'))
	call mkdir(expand('~/.vim/undo'), 'p', 0700)
endif

if has("autocmd")
	filetype plugin indent on
endif

highlight ExtraSpaces ctermbg=gray ctermfg=white
autocmd InsertEnter * match ExtraSpaces /\s\+\%#\@<!$/
autocmd InsertLeave * match ExtraSpaces /\s\+$/
hi Search cterm=NONE ctermfg=black ctermbg=lightgreen
if &term =~ '256color'
  set t_ut=
endif
set listchars=eol:$,tab:>-,trail:~,extends:>,precedes:<

" ============================================================================
" coc.nvim — completion & LSP
" ============================================================================
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"
function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction
if has('nvim')
  inoremap <silent><expr> <c-space> coc#refresh()
else
  inoremap <silent><expr> <c-@> coc#refresh()
endif

" (airline refreshes coc status automatically — no manual update hook needed)

" Diagnostic navigation: errors vs warnings separately
nmap <silent> [e <Plug>(coc-diagnostic-prev-error)
nmap <silent> ]e <Plug>(coc-diagnostic-next-error)
nmap <silent> [w <Plug>(coc-diagnostic-prev)
nmap <silent> ]w <Plug>(coc-diagnostic-next)
" (kept my originals too)
nmap <silent> [g <Plug>(coc-diagnostic-prev)
nmap <silent> ]g <Plug>(coc-diagnostic-next)

" ---- LSP go-to that integrates with vim's tagstack (Ctrl-O / Ctrl-I) ----
function! TagstackPush(item)
	let tagstack = gettagstack()
	let curidx = tagstack['curidx']
	let winid = winnr()
	if curidx == (tagstack['length'] + 1)
		call add(tagstack['items'], a:item)
		let tagstack['length'] = curidx
	else
		let tagstack['items'][curidx-1] = a:item
	endif
	call settagstack(winid, tagstack, 'r')
	call settagstack(winid, {'curidx' : curidx + 1})
endfunction
function! GotoTag(goto_kind)
	let tag_name = expand('<cword>')
	let curpos = getcurpos()
	let curpos[0] = bufnr()
	if CocAction('jump' . a:goto_kind)
		let tagstack_item = {'tagname' : tag_name, 'from' : curpos}
		call TagstackPush(tagstack_item)
	endif
endfunction

" nvim 0.11+ ships default gr* LSP maps (grr/gri/grn/gra/grt). A bare `gr` map
" then becomes an ambiguous prefix -> 1s timeout before coc-references fires.
" Remove those defaults so `gr` is unambiguous. (vim has no such maps.)
if has('nvim')
	for s:k in ['grr','gri','grn','gra','grt']
		silent! execute 'nunmap ' . s:k
	endfor
endif

" GoTo navigation (my original mappings, now tagstack-aware where useful)
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gr <Plug>(coc-references)
nmap <silent> gy <Plug>(coc-type-definition)
" tagstack-aware jumps — Ctrl-O / Ctrl-I history works after these.
" Under ,x* so the ,d* prefix is free for the debugger (see vimspector below).
nmap <silent> ,xd :call GotoTag("Definition")<CR>
nmap <silent> ,xr :call GotoTag("References")<CR>
nmap <silent> ,xi :call GotoTag("Implementation")<CR>
" NOTE: no space before <Plug> — a literal space acts as 'l' and moves the
" cursor off <cword> before the jump, landing on the wrong symbol.
nmap <silent> g<space>d <C-W><C-V><Plug>(coc-definition)
nmap <silent> g<space>r <C-W><C-V><Plug>(coc-references)
nmap <silent> g<space>y <C-W><C-V><Plug>(coc-type-definition)
nmap <silent> g<space>i <C-W><C-V><Plug>(coc-implementation)
nmap <silent> g<space><space>d <C-W><C-S><Plug>(coc-definition)
nmap <silent> g<space><space>r <C-W><C-S><Plug>(coc-references)
nmap <silent> g<space><space>y <C-W><C-S><Plug>(coc-type-definition)
nmap <silent> g<space><space>i <C-W><C-S><Plug>(coc-implementation)

function! s:show_documentation()
  if CocAction('hasProvider', 'hover')
    call CocActionAsync('doHover')
  else
    call feedkeys('K', 'in')
  endif
endfunction
nnoremap <silent> T :call <SID>show_documentation()<CR>

