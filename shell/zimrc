# ~/.zimrc — zim module list. Order matters (see comments).
# Prompt is NOT here — we use starship (initialized in .zshrc).

# Core zim modules
zmodule environment          # sane zsh defaults
zmodule git                  # git aliases/functions
zmodule input                # better line-editing defaults
zmodule utility              # ls colors, safe-ops aliases

# Completions must be added to fpath BEFORE the completion module runs compinit
zmodule zsh-users/zsh-completions --fpath src
zmodule completion           # runs compinit

# fzf-tab: replaces the tab menu with an fzf picker. MUST come after `completion`
# (needs compinit) and before widget-wrapping plugins below.
zmodule Aloxaf/fzf-tab

# Widget-wrapping plugins — order: autosuggestions -> syntax highlight -> hist search
zmodule zsh-users/zsh-autosuggestions
zmodule zdharma-continuum/fast-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search   # last: binds ↑/↓
