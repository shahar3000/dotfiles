# ~/.zshenv — portable (Linux-first, macOS-aware).
# In .zshenv (not .zprofile) so PATH/env is set for ALL shells — including
# non-login interactive shells, which Linux terminal emulators commonly spawn
# and which do NOT source .zprofile. This makes brew/go/cargo tools reliably
# visible to the detection blocks in .zshrc.

# ---- Homebrew (macOS / Linuxbrew / user-local), first one present wins ----
# `brew shellenv` is a Ruby startup (~200-500ms) and this file is sourced by EVERY
# shell, incl. non-interactive `zsh -c`. Its output is static (only brew's paths),
# so cache it to ~/.cache and just source the cache — regenerating only when the
# brew binary is newer than the cache (i.e. brew moved/upgraded). The cache is
# machine-local (never in the tracked repo), so per-machine prefixes stay correct.
for _brew in \
	/opt/homebrew/bin/brew \
	/usr/local/bin/brew \
	/home/linuxbrew/.linuxbrew/bin/brew \
	"$HOME/.homebrew/bin/brew"; do          # user-local (no-sudo) install
	if [ -x "$_brew" ]; then
		_brew_cache="${XDG_CACHE_HOME:-$HOME/.cache}/brew-shellenv.zsh"
		if [ -s "$_brew_cache" ] && [ "$_brew_cache" -nt "$_brew" ]; then
			source "$_brew_cache"
		# Regenerate: write to a temp then atomic-rename so a concurrent shell can't
		# source a half-written cache. Only attempt it when the cache dir is
		# writable (checked first, so a failed '>' redirect can't spew a shell error
		# to stderr on every restricted `zsh -c`). Otherwise fall back to a live eval
		# so brew env is always applied — never silently lost.
		elif mkdir -p "${_brew_cache:h}" 2>/dev/null && [ -w "${_brew_cache:h}" ] \
			&& "$_brew" shellenv > "$_brew_cache.$$" 2>/dev/null \
			&& mv -f "$_brew_cache.$$" "$_brew_cache" 2>/dev/null; then
			source "$_brew_cache"
		else
			rm -f "$_brew_cache.$$" 2>/dev/null   # clean up a failed temp if any
			eval "$("$_brew" shellenv)"           # cache unavailable — live fallback
		fi
		unset _brew_cache
		break
	fi
done
unset _brew

# ---- default editor for all shells + tools (git, crontab, etc.) ----
# AFTER the brew shellenv loop so a brew-only nvim/vim is on PATH before we probe.
# In zshenv (not zshrc) so non-interactive tools honor it too. Prefer nvim, then
# vim, then vi, so any box still gets a usable editor.
if command -v nvim >/dev/null 2>&1; then
	export EDITOR="nvim" VISUAL="nvim"
elif command -v vim >/dev/null 2>&1; then
	export EDITOR="vim" VISUAL="vim"
elif command -v vi >/dev/null 2>&1; then
	export EDITOR="vi" VISUAL="vi"
fi

# ---- Go ----
# Don't export GOROOT: the toolchain computes it itself, a hardcoded value breaks
# on upgrade/move, and probing `go env GOROOT` here would spawn `go` on EVERY shell
# (incl. non-interactive `zsh -c`). GOPATH/GOBIN are cheap statics.
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="$PATH:${GOPATH}/bin"
typeset -U path PATH   # keep PATH de-duplicated across re-sources (e.g. rezsh)

# ---- Rust ----
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# ---- LLVM (brew) ----
# Derive from $HOMEBREW_PREFIX (exported by the brew shellenv above) instead of
# spawning `brew --prefix llvm`, which is a slow Ruby startup on EVERY shell incl.
# non-interactive `zsh -c`. brew always symlinks a formula at $PREFIX/opt/<name>.
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -d "$HOMEBREW_PREFIX/opt/llvm" ]; then
	_llvm="$HOMEBREW_PREFIX/opt/llvm"
	export PATH="$_llvm/bin:$PATH"
	export LDFLAGS="-L$_llvm/lib"
	export CPPFLAGS="-I$_llvm/include"
	unset _llvm
fi

# ---- vimwiki markdown ----
export VIMWIKI_MARKDOWN_EXTENSIONS='{"toc": {"baselevel": 2 }, "nl2br": {}}'
